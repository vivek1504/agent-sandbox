# agent-sandbox service configuration.
#
# provision.sh copies this to /etc/agent-sandbox/sandbox.env, which the systemd
# unit reads. Values here are defaults for a single-host deployment; see the
# Configuration table in the root README for every supported variable.
#
# systemd parses this file itself: no `export`, no shell expansion, no quotes
# around values unless the quotes are part of the value.

# --- server ---------------------------------------------------------------
PORT=3000

# The application default is `silent`. Leaving it silent means a server that
# starts, serves, and tells you nothing — including when template registration
# fails at boot. Keep this at info.
LOG_LEVEL=info

NODE_ENV=production

# --- authentication -------------------------------------------------------
AUTH_ENABLED=true
AUTH_KEYS_PATH=/var/lib/agent-sandbox/keys.json
AUTH_KEY_PREFIX=sk_live_

# --- capacity -------------------------------------------------------------
# Concurrent microVMs. The application default is 254, which is a network-slot
# limit rather than a memory-aware one: 254 desktop VMs at a 2 GiB cgroup
# ceiling would need 500 GiB. Set this to what the host's RAM actually supports.
#   rule of thumb: (usable RAM in GiB) / (largest template's ceiling in GiB)
VM_MAX_SLOTS=16

# --- default per-VM resources --------------------------------------------
# These apply to templates built WITHOUT a build.env. A template that has one
# carries its own limits in template.json and overrides everything here at
# restore, so raising these is rarely what you want.
VM_VCPU_COUNT=1
VM_MEM_SIZE_MIB=128
VM_CPU_QUOTA_US=50000
VM_CPU_PERIOD_US=100000
VM_MEMORY_LIMIT_BYTES=134217728
VM_NOFILE_LIMIT=1024
VM_PIDS_LIMIT=256

# --- guest egress ---------------------------------------------------------
# none | allow | deny. `none` lets guests reach anything the host can reach.
VM_DNS_MODE=none
VM_DNS_DOMAINS=
VM_DNS_UPSTREAM=8.8.8.8,1.1.1.1

# Blocking the cloud metadata endpoint matters on any cloud VPS: a guest that
# reaches 169.254.169.254 can read the instance role's credentials. On AWS also
# enforce IMDSv2 at the instance level (HttpTokens=required).
VM_DEST_MODE=deny
VM_DEST_RULES=169.254.169.254/32

VM_BW_ENABLED=false
VM_BW_RATE_KBIT=10240
VM_BW_BURST_KBIT=1024

# --- paths ----------------------------------------------------------------
FIRECRACKER_BIN=/usr/local/bin/firecracker
FIRECRACKER_JAILER_BIN=/usr/local/bin/jailer
FIRECRACKER_JAIL_BASE=/var/lib/agent-sandbox/jailer
FIRECRACKER_ARTIFACTS_DIR=/var/lib/agent-sandbox/artifacts
FIRECRACKER_UID=997
FIRECRACKER_GID=982

# Fail fast when chmod/chown on jail directories fails, instead of continuing
# with weaker permissions than intended.
STRICT_PERMISSIONS=true
