# Server Configuration
PORT=3000

# Authentication Configuration
AUTH_ENABLED=true
AUTH_KEYS_PATH=/var/lib/agent-sandbox/keys.json
AUTH_KEY_PREFIX=sk_test_

# MicroVM Resource Configurations
VM_VCPU_COUNT=1
VM_MEM_SIZE_MIB=128
VM_CPU_QUOTA_US=50000
VM_CPU_PERIOD_US=100000
VM_MEMORY_LIMIT_BYTES=134217728
VM_NOFILE_LIMIT=1024
VM_DISK_LIMIT_BYTES=536870912
VM_PIDS_MAX=256
STRICT_PERMISSIONS=false

# Firecracker and Jailer System Paths (Optional/Defaults shown)
FIRECRACKER_JAILER_BIN=/usr/local/bin/jailer
FIRECRACKER_BIN=/usr/local/bin/firecracker
FIRECRACKER_JAIL_BASE=/var/lib/agent-sandbox/jailer
FIRECRACKER_ARTIFACTS_DIR=/var/lib/agent-sandbox/artifacts
FIRECRACKER_UID=997
FIRECRACKER_GID=982

# Egress Network Isolation & Policy Configurations
VM_DNS_MODE=none           # "none" | "allow" | "deny"
VM_DNS_DOMAINS=            # Comma-separated domain list e.g. "*.npmjs.org,github.com"
VM_DNS_UPSTREAM=8.8.8.8,1.1.1.1 # Comma-separated upstream DNS servers
VM_DEST_MODE=none          # "none" | "allow" | "deny"
VM_DEST_RULES=            # Comma-separated CIDR rules e.g. "169.254.169.254/32,10.0.0.0/8:443/tcp"
VM_BW_ENABLED=false        # Enable bandwidth throttling (true / false)
VM_BW_RATE_KBIT=10240      # Rate limit in kbit/s (10240 = 10 Mbit/s)
VM_BW_BURST_KBIT=1024      # Burst allowance in kbit


